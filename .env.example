# Copiar a .env y completar. NUNCA commitear .env.

# --- obligatorio en producción ---
# generar con: openssl rand -base64 32
TEG_ADMIN_TOKEN=

# dominio público (con https) usado para armar los join links
TEG_PUBLIC_BASE_URL=https://teg.example.com

# orígenes permitidos para CORS (frontend), separados por coma
TEG_CORS_ORIGINS=https://teg.example.com

# --- red ---
TEG_HOST=127.0.0.1
TEG_PORT=8123

# dominio para el Caddy en contenedor (perfil edge)
TEG_DOMAIN=teg.example.com

# --- entorno ---
TEG_ENV=prod                 # dev habilita /docs; prod los apaga
TEG_LOG_LEVEL=INFO
TEG_DEBUG_PAGE=true          # página /dev de prueba (apagar cuando haya frontend)
TEG_DB_PATH=data/teg.db

# --- comentarista IA ---
TEG_COMMENTATOR_ENABLED=true
TEG_COMMENTATOR_PROVIDER=mock   # mock | ollama
TEG_COMMENTATOR_COOLDOWN_SECONDS=15
TEG_HUMOR_LEVEL_DEFAULT=2
TEG_HUMOR_LEVEL_MAX=3           # subir a 4 solo si el grupo lo consiente
TEG_OLLAMA_URL=http://127.0.0.1:11434
TEG_OLLAMA_MODEL=llama3.2

# --- límites ---
TEG_REST_REQUESTS_PER_MINUTE=240
TEG_WS_MAX_MESSAGE_BYTES=8192
TEG_WS_MESSAGES_PER_WINDOW=20
TEG_WS_WINDOW_SECONDS=5
