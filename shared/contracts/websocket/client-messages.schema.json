{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teg/websocket/client-messages",
  "title": "ClientMessage",
  "description": "Mensajes cliente->servidor. Maximo 8 KiB por mensaje.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "enum": ["ping", "ready.set", "chat.send", "dice.roll", "attack", "turn.end"] },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "properties": { "type": { "const": "ping" } } },
    {
      "properties": {
        "type": { "const": "ready.set" },
        "payload": {
          "type": "object",
          "properties": { "ready": { "type": "boolean", "default": true } }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "chat.send" },
        "payload": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "maxLength": 500 },
            "target_player_id": {
              "type": ["string", "null"],
              "description": "null => mensaje público; id => mensaje privado"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "dice.roll" },
        "payload": {
          "type": "object",
          "required": ["count"],
          "properties": { "count": { "type": "integer", "minimum": 1, "maximum": 3 } }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "attack" },
        "payload": {
          "type": "object",
          "required": ["target_player_id"],
          "properties": {
            "target_player_id": { "type": "string" },
            "attacker_dice": { "type": "integer", "minimum": 1, "maximum": 3, "default": 3 }
          }
        }
      }
    },
    { "properties": { "type": { "const": "turn.end" } } }
  ]
}
