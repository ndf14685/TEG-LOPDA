# Alternativa con nginx (si se prefiere a Caddy).
# Requiere certbot para HTTPS: certbot --nginx -d teg.example.com
# Reemplazar teg.example.com por el dominio real.

server {
    listen 80;
    server_name teg.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name teg.example.com;

    # certbot completa estas rutas:
    # ssl_certificate     /etc/letsencrypt/live/teg.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/teg.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    client_max_body_size 2m;

    location /metrics { return 404; }

    location /ws/ {
        proxy_pass http://127.0.0.1:8123;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8123;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
